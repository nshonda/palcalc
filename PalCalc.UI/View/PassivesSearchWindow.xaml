<adonisControls:AdonisWindow x:Class="PalCalc.UI.View.PassivesSearchWindow"
                             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                             xmlns:local="clr-namespace:PalCalc.UI.View"
                             xmlns:util="clr-namespace:Wpf.Util"
                             xmlns:mvm="clr-namespace:PalCalc.UI.ViewModel.Mapped"
                             xmlns:itl="clr-namespace:PalCalc.UI.Localization"
                             xmlns:adonisControls="clr-namespace:AdonisUI.Controls;assembly=AdonisUI"
                             xmlns:adonisExtensions="clr-namespace:AdonisUI.Extensions;assembly=AdonisUI"
                             mc:Ignorable="d"
                             WindowStartupLocation="CenterOwner"
                             IconVisibility="Collapsed"
                             DataContext="{Binding RelativeSource={RelativeSource Self}}"
                             Title="{itl:LocalizedText Code=LC_TRAITS_SEARCH_TITLE}"
                             Height="450" Width="1060"
                             >
    <Window.Style>
        <Style TargetType="Window" BasedOn="{StaticResource {x:Type Window}}" />
    </Window.Style>
    <Window.Resources>
        <mvm:RankColorConverter x:Key="RCC" />
        <mvm:StatCategoryColorConverter x:Key="SCC" />
        <Style TargetType="ScrollBar" BasedOn="{StaticResource {x:Type ScrollBar}}">
            <Setter Property="adonisExtensions:ScrollBarExtension.ExpansionMode" Value="AlwaysExpand" />
        </Style>
    </Window.Resources>
    <DockPanel>
        <DockPanel DockPanel.Dock="Top" Margin="10,10">
            <TextBlock DockPanel.Dock="Left" Text="{itl:LocalizedText Code=LC_TRAITS_SEARCH_SEARCH}" Margin="0,0,8,0" VerticalAlignment="Center" />

            <ComboBox DockPanel.Dock="Right" Width="220" Margin="8,0,0,0"
                      ItemsSource="{Binding StatFilterOptions}"
                      SelectedItem="{Binding SelectedStatFilter}"
                      DisplayMemberPath="DisplayLabel" />

            <TextBox x:Name="m_TextBox" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" />
        </DockPanel>

        <ListView ItemsSource="{Binding DisplayedOptions}" util:GridViewSort.AutoSort="True">
            <ListView.ItemContainerStyle>
                <Style TargetType="ListViewItem" BasedOn="{StaticResource {x:Type ListViewItem}}">
                    <Setter Property="Padding" Value="0,4" />
                    <Setter Property="VerticalContentAlignment" Value="Center" />
                </Style>
            </ListView.ItemContainerStyle>
            <ListView.View>
                <GridView>
                    <GridView.ColumnHeaderContainerStyle>
                        <Style TargetType="GridViewColumnHeader" BasedOn="{StaticResource {x:Type GridViewColumnHeader}}">
                            <Setter Property="Padding" Value="6,2" />
                        </Style>
                    </GridView.ColumnHeaderContainerStyle>
                    <GridView.Columns>
                        <GridViewColumn Header="{itl:LocalizedText Code=LC_TRAITS_SEARCH_NAME}" util:GridViewSort.PropertyName="Name" Width="Auto">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate DataType="{x:Type mvm:PassiveSkillViewModel}">
                                    <StackPanel Orientation="Horizontal">
                                        <Border CornerRadius="99"
                                                Padding="2"
                                                BorderThickness="0"
                                                Margin="0,0,4,0"
                                                VerticalAlignment="Center"
                                                >
                                            <Rectangle Width="15"
                                                       Height="15"
                                                       Fill="{Binding Rank, Converter={StaticResource RCC}}">
                                                <Rectangle.OpacityMask>
                                                    <ImageBrush ImageSource="{Binding RankIcon}" />
                                                </Rectangle.OpacityMask>
                                            </Rectangle>
                                        </Border>

                                        <TextBlock Text="{Binding Name.Value}" VerticalAlignment="Center" />
                                    </StackPanel>
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>

                        <GridViewColumn Header="Atk"  util:GridViewSort.PropertyName="AttackValue"    DisplayMemberBinding="{Binding AttackValue}"    Width="44" />
                        <GridViewColumn Header="Elem" util:GridViewSort.PropertyName="ElementValue"   DisplayMemberBinding="{Binding ElementDisplay}" Width="70" />
                        <GridViewColumn Header="Def"  util:GridViewSort.PropertyName="DefenseValue"   DisplayMemberBinding="{Binding DefenseValue}"   Width="44" />
                        <GridViewColumn Header="Work" util:GridViewSort.PropertyName="WorkSpeedValue" DisplayMemberBinding="{Binding WorkSpeedValue}" Width="48" />
                        <GridViewColumn Header="Spd"  util:GridViewSort.PropertyName="MoveSpeedValue" DisplayMemberBinding="{Binding MoveSpeedValue}" Width="44" />
                        <GridViewColumn Header="Wt"   util:GridViewSort.PropertyName="WeightValue"    DisplayMemberBinding="{Binding WeightValue}"    Width="44" />

                        <GridViewColumn Header="Stats" Width="300">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate DataType="{x:Type mvm:PassiveSkillViewModel}">
                                    <ItemsControl ItemsSource="{Binding StatBreakdown}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <WrapPanel />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate DataType="{x:Type mvm:PassiveStatViewModel}">
                                                <Border CornerRadius="3" Padding="4,1" Margin="0,1,3,1"
                                                        Background="{Binding Category, Converter={StaticResource SCC}}">
                                                    <TextBlock Text="{Binding}" FontSize="11" Foreground="#E6EEF2" />
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>

                        <GridViewColumn Header="{itl:LocalizedText Code=LC_TRAITS_SEARCH_DESCRIPTION}"
                                        Width="230"
                                        util:GridViewSort.PropertyName="Description"
                                        >
                            <GridViewColumn.CellTemplate>
                                <DataTemplate DataType="{x:Type mvm:PassiveSkillViewModel}">
                                    <TextBlock Text="{Binding Description.Value}" TextWrapping="Wrap" />
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                    </GridView.Columns>
                </GridView>
            </ListView.View>
        </ListView>
    </DockPanel>
</adonisControls:AdonisWindow>
